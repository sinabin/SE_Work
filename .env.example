# 실제 값은 .env 또는 별도 비밀관리 방식으로 주입하고 Git에 커밋하지 않는다.
DB_HOST=localhost
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME
DB_NAME=monitoring_db

# 일반 SNMP 점검
SNMP_COMMUNITY=CHANGE_ME

# VVB 전용 SNMP
VVB_SNMP_COMMUNITY=CHANGE_ME

# 과거 system_check.sh에서 사용하던 별도 MySQL 계정
LEGACY_DB_USER=CHANGE_ME
LEGACY_DB_PASS=CHANGE_ME
LEGACY_DB_NAME=CHANGE_ME
